# ==== Database ====
DATABASE_URL=jdbc:postgresql://localhost:5432/onetutor
DATABASE_USERNAME=onetutor
DATABASE_PASSWORD=onetutor_dev_password

# ==== JWT ====
# Generate a real 256-bit+ secret for production: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret-in-production-min-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# ==== Storage ====
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# ==== Mail Setup (Gmail, Brevo, Outlook, or any SMTP provider) ====
# For Gmail: Set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=your@gmail.com,
# and MAIL_PASSWORD=your-16-character-google-app-password (generated in Google Account -> Security -> 2-Step Verification -> App Passwords).
# When MAIL_USERNAME is empty, OneTutor safely logs all OTPs and emails to the backend terminal console.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=suryadeveloper15@gmail.com
MAIL_PASSWORD=cngixxcduyrzgxrg
MAIL_FROM=suryadeveloper15@gmail.com
MAIL_SENDER_NAME=OneTutor Academy
MAIL_LOGIN_ALERT_ENABLED=false

# ==== App ====
APP_BASE_URL=http://localhost:5173
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==== Google OAuth 2.0 ====
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=415709486195-i7irlufbupli5e221l0iakjg9ts18u8p.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=415709486195-i7irlufbupli5e221l0iakjg9ts18u8p.apps.googleusercontent.com

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ==== Razorpay Payment Gateway ====
# Test Mode Keys: generated at https://dashboard.razorpay.com/app/keys
# Start with rzp_test_... for sandbox testing, or rzp_live_... for live payments.
# If left as placeholder or empty, OneTutor runs in test/simulated mode.
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_ENABLED=true


